{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "node": "22.23.1",
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "developmentClient": false,
      "node": "22.23.1",
      "autoIncrement": false,
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "image": "sdk-57",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "store-draft": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
