# Public values embedded in the mobile bundle. Never put server secrets here.
EXPO_PUBLIC_API_URL=https://api.iaaprova.com.br
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_in_eas_secret
# Store-specific public SDK keys from RevenueCat. These are safe for the app
# bundle, but must still be supplied per EAS build profile.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_in_eas_environment
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_in_eas_environment
EXPO_PUBLIC_TERMS_URL=https://iaaprova.com.br/terms/
EXPO_PUBLIC_PRIVACY_URL=https://iaaprova.com.br/privacy/
EXPO_PUBLIC_HELP_URL=https://iaaprova.com.br/support/
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://iaaprova.com.br/account-deletion/
