{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaaprova.com.br/schemas/rights-registry.schema.json",
  "title": "IA Aprova Rights Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "records", "blockingReasons", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["blocked_no_approved_rights_documents", "active"] },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "status", "instrumentHash", "holder", "preparedById", "territories", "platforms", "permissions", "validFrom", "validUntil", "approval"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "type": { "enum": ["official_license", "authoring_agreement", "asset_license"] },
          "status": { "enum": ["draft", "active", "expired", "revoked", "suspended"] },
          "instrumentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "holder": { "type": "string", "minLength": 2 },
          "preparedById": { "type": "string", "minLength": 3 },
          "territories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "platforms": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["ios", "android", "web"] } },
          "permissions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["commercial", "digital", "reproduce", "adapt", "fragment", "sublicense"] } },
          "validFrom": { "type": "string", "format": "date" },
          "validUntil": { "type": ["string", "null"], "format": "date" },
          "approval": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewerId", "decision", "reviewedAt"],
            "properties": {
              "reviewerId": { "type": "string", "minLength": 3 },
              "decision": { "const": "approved" },
              "reviewedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
