{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaaprova.com.br/schemas/eligible-batches.schema.json",
  "title": "IA Aprova Eligible Batch Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "semanticDeduplicationPolicy", "batches", "blockingReasons", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["blocked_empty_corpus", "active"] },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "semanticDeduplicationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "methodVersion", "corpusSnapshotHash", "preparedById", "approval"],
      "properties": {
        "status": { "enum": ["blocked", "approved"] },
        "methodVersion": { "type": ["string", "null"] },
        "corpusSnapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "preparedById": { "type": ["string", "null"] },
        "approval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reviewerId", "decision", "reviewedAt"],
          "properties": {
            "reviewerId": { "type": "string", "minLength": 3 },
            "decision": { "const": "approved" },
            "reviewedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "relativePath", "sha256", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "relativePath": { "type": "string", "minLength": 3 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "state": { "const": "eligible_candidate" }
        }
      }
    }
  }
}
