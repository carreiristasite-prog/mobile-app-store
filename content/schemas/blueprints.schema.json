{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iaaprova.com.br/schemas/blueprints.schema.json",
  "title": "IA Aprova Blueprint Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "blueprints", "blockingReasons", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["blocked_missing_approved_blueprints", "active"] },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "blueprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "familyId", "trackId", "cargo", "banca", "edital", "phase", "modality", "preparedById", "sourceDocumentHash", "subjects", "approval"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "minLength": 2 },
          "status": { "enum": ["draft", "approved", "retired", "suspended"] },
          "familyId": { "type": "string", "minLength": 2 },
          "trackId": { "type": "string", "minLength": 2 },
          "cargo": { "type": "string", "minLength": 2 },
          "banca": { "type": "string", "minLength": 2 },
          "phase": { "type": "string", "minLength": 2 },
          "modality": { "type": "string", "minLength": 2 },
          "preparedById": { "type": "string", "minLength": 3 },
          "sourceDocumentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "edital": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "sourceUrl", "sourceHash"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "title": { "type": "string", "minLength": 2 },
              "sourceUrl": { "type": "string", "minLength": 2 },
              "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "subjects": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "targetEligibleItems", "topics"],
              "properties": {
                "id": { "type": "string", "minLength": 2 },
                "name": { "type": "string", "minLength": 2 },
                "targetEligibleItems": { "type": "integer", "minimum": 1000 },
                "topics": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "name", "skills"],
                    "properties": {
                      "id": { "type": "string", "minLength": 2 },
                      "name": { "type": "string", "minLength": 2 },
                      "skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } }
                    }
                  }
                }
              }
            }
          },
          "approval": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewerId", "decision", "reviewedAt"],
            "properties": {
              "reviewerId": { "type": "string", "minLength": 3 },
              "decision": { "const": "approved" },
              "reviewedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
